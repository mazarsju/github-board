# Copy this file to .env (ignored by git).

# GitHub token used by the server. When set, no login is asked:
# anyone who can reach the server uses this token (keep it for local use).
# Otherwise, each user enters their token in the UI (kept in memory by the server).
GITHUB_TOKEN=

# Jira Cloud: "Actions for me" lists your tickets (assigned to you, mentioning you
# in a comment, or that you commented on). Needs all three, and GITHUB_TOKEN.
# JIRA_URL=https://acme.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_TOKEN=

# Backend listen address (default: 127.0.0.1:3001).
# HOST=127.0.0.1
# PORT=3001

# Personal data file (default: server/data/state.json).
# DATA_FILE=server/data/state.json

# "Review" button: Claude Code executable (default: claude, from the PATH)
# and folder the background sessions start in (default: the server's folder).
# CLAUDE_BIN=/path/to/claude
# CLAUDE_CWD=/path/to/repo
